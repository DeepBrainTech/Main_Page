{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main-page",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "main-page"
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {},
  "preview_urls": true
}
