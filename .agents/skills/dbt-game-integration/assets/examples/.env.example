# Freefall Chess reference configuration; no real secrets are included.
# A new game must use its own assigned prefix, audience, and secret values.
CHESSMATER_JWT_SECRET=
CHESSMATER_JWT_ALG=HS256
CHESSMATER_JWT_AUD=chessmater
CHESSMATER_JWT_ISS=main-portal
CHESSMATER_TOKEN_EXPIRE_SECONDS=300

# Optional reward signing secret; if absent, the portal falls back to JWT_SECRET.
CHESSMATER_REWARD_SECRET=

# Game backend only: its local session differs from the portal login token.
# The current game falls back to JWT_SECRET if SESSION_JWT_SECRET is unset.
CHESSMATER_SESSION_JWT_SECRET=
CHESSMATER_SESSION_JWT_AUD=chessmater-session
CHESSMATER_SESSION_JWT_ISS=chessmater-backend
CHESSMATER_SESSION_EXPIRE_SECONDS=86400

# Game backend only: configure actual origins and portal API base per environment.
ALLOWED_ORIGINS=
PORTAL_API_URL=

# Configure the actual portal API origin through your frontend framework.
# Only public origins belong in frontend environment variables; never JWT secrets.
